
int GetAndroidSdkVersion() {
    int sdk = 0;
    FILE *fp = fopen("/system/build.prop", "r");
    if (fp) {
        char line[128];
        while (fgets(line, sizeof(line), fp)) {
            if (sscanf(line, "ro.build.version.sdk=%d", &sdk) == 1) {
                break;
            }
        }
        fclose(fp);
    }
    return sdk;
}
