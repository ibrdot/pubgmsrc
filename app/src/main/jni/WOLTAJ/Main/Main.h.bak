    system("chmod 777 /data/data/com.pubg.imobile/shared_prefs");
    system("rm -rf /data/data/com.pubg.imobile/files");
    std::string guestFile = "/data/data/com.pubg.imobile/shared_prefs/device_id.xml";
    system(("rm -rf " + guestFile).c_str());

    std::ofstream file(guestFile);
    if (file.is_open()) {
        file << "<?xml version='1.0' encoding='utf-8' standalone='yes' ?>\n";
        file << "<map>\n";
