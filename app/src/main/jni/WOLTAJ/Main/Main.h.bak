void Theme()
{
	
  ImGuiStyle& style = ImGui::GetStyle();

          // --- Stil Ayarları ---
        style.WindowPadding = ImVec2(8, 8);
        style.WindowRounding = 3.5f;
        style.FramePadding = ImVec2(4, 4);
        style.ScrollbarSize = 0.0f;
        style.FrameRounding = 3.5f;
        style.FrameBorderSize = 1.0f; // Kutuların etrafını belirginleştirir
        style.WindowBorderSize = 0.0f;
        style.WindowTitleAlign = ImVec2(0.5f, 0.5f);
        style.GrabMinSize = 20.0f;
        style.ButtonTextAlign = ImVec2(0.5f, 0.5f);

        // --- Renk Ayarları ---
        
        // Ana Arka Plan (Koyu ve Kapalı)
        style.Colors[ImGuiCol_WindowBg]         = ImColor(0, 0, 0, 235); 
        
        // CheckBox ve Slider Arka Planı (Gri - Görünür olması için)
        style.Colors[ImGuiCol_FrameBg]          = ImColor(45, 45, 45, 255); 
        style.Colors[ImGuiCol_FrameBgHovered]   = ImColor(60, 60, 60, 255);
        style.Colors[ImGuiCol_FrameBgActive]    = ImColor(70, 70, 70, 255);
        style.Colors[ImGuiCol_Border]           = ImColor(80, 80, 80, 100); 
        
        // Butonlar (UnLoad, Actor Dump, Save/Load - Gri İç Kaplama)
        style.Colors[ImGuiCol_Button]           = ImColor(45, 45, 45, 255); 
        style.Colors[ImGuiCol_ButtonHovered]    = ImColor(60, 60, 60, 255);
        style.Colors[ImGuiCol_ButtonActive]     = ImColor(35, 35, 35, 255);
        
        // Üst Başlık (Title Bar - Kırmızı Tema)
        style.Colors[ImGuiCol_TitleBg]          = ImColor(122, 41, 39, 255);
        style.Colors[ImGuiCol_TitleBgActive]    = ImColor(122, 41, 39, 255);
        style.Colors[ImGuiCol_TitleBgCollapsed] = ImColor(122, 41, 39, 200);
        
        // Checkmark ve Slider Kaydıraçları
        style.Colors[ImGuiCol_CheckMark]        = ImColor(0, 255, 0, 255); // Aktif yeşil
        style.Colors[ImGuiCol_SliderGrab]       = ImColor(122, 41, 39, 255); // Kırmızı kaydıraç
        style.Colors[ImGuiCol_SliderGrabActive] = ImColor(150, 50, 48, 255);
        
        // Metin Rengi
        style.Colors[ImGuiCol_Text]             = ImColor(255, 255, 255, 255);

}
