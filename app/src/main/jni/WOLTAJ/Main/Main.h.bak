void DrawBorderString(ImFont *pFont, float FontSize, string Text, float X, float Y, ImColor Color, bool Center)
{
    pImGuiDraw = ImGui::GetBackgroundDrawList();
    if (Setting::textborder)
    {
        ImVec2 TextSize = pFont->CalcTextSizeA(FontSize, FLT_MAX, 0.0f, Text.c_str());
        pImGuiDraw->AddText(pFont, FontSize, ImVec2((X - TextSize.x / 2.0f) + 1.0f, Y + 1.0f), Black, Text.c_str());
        pImGuiDraw->AddText(pFont, FontSize, ImVec2((X - TextSize.x / 2.0f) - 1.0f, Y - 1.0f), Black, Text.c_str());
        pImGuiDraw->AddText(pFont, FontSize, ImVec2((X - TextSize.x / 2.0f) + 1.0f, Y - 1.0f), Black, Text.c_str());
        pImGuiDraw->AddText(pFont, FontSize, ImVec2((X - TextSize.x / 2.0f) - 1.0f, Y + 1.0f), Black, Text.c_str());
        pImGuiDraw->AddText(pFont, FontSize, ImVec2(X - TextSize.x / 2.0f, Y), Color, Text.c_str());
    }
    else
    {

        ImVec2 TextSize = pFont->CalcTextSizeA(FontSize, FLT_MAX, 0.0f, Text.c_str());
        pImGuiDraw->AddText(pFont, FontSize, ImVec2(X - TextSize.x / 2.0f, Y), Color, Text.c_str());
    }
}
void DrawBorderStringW(ImFont *pFont, float FontSize, wstring Text, float X, float Y, ImColor Color, ImColor Color2, bool Center)
{
pImGuiDraw = ImGui::GetBackgroundDrawList();
    std::wstring_convert<std::codecvt_utf8<wchar_t>> myconv;
    std::string Texts = myconv.to_bytes(Text).c_str();
    if (Setting::textborder)
    {
        ImVec2 TextSize = pFont->CalcTextSizeA(FontSize, FLT_MAX, 0.0f, Texts.c_str());
        pImGuiDraw->AddText(pFont, FontSize, ImVec2((X - TextSize.x / 2.0f) + 1.0f, Y + 1.0f), Color2, Texts.c_str());
        pImGuiDraw->AddText(pFont, FontSize, ImVec2((X - TextSize.x / 2.0f) - 1.0f, Y - 1.0f), Color2, Texts.c_str());
        pImGuiDraw->AddText(pFont, FontSize, ImVec2((X - TextSize.x / 2.0f) + 1.0f, Y - 1.0f), Color2, Texts.c_str());
        pImGuiDraw->AddText(pFont, FontSize, ImVec2((X - TextSize.x / 2.0f) - 1.0f, Y + 1.0f), Color2, Texts.c_str());
        pImGuiDraw->AddText(pFont, FontSize, ImVec2(X - TextSize.x / 2.0f, Y), Color, Texts.c_str());
    }
    else
    {
        ImVec2 TextSize = pFont->CalcTextSizeA(FontSize, FLT_MAX, 0.0f, Texts.c_str());
        pImGuiDraw->AddText(pFont, FontSize, ImVec2(X - TextSize.x / 2.0f, Y), Color, Texts.c_str());
    }
}
struct Matrix
{
    float m[4][4];
};

Matrix GetMatrix()
{
    static UCanvas* Canvas = nullptr;

    if (Canvas == nullptr)
    {
        Canvas = UObject::FindObject<UCanvas>("Canvas Transient.DebugCanvasObject");
    }

    if (!Canvas)
    {
        return Matrix{};
    }

    uintptr_t lodalele;

#if defined(__LP64__)
    lodalele = 0x270;
#else
    lodalele = 0x200;
#endif

    return *(Matrix*)((uintptr_t)Canvas + lodalele);
}
void AddItem(const char *CheckboxName, bool *CheckboxbooleanPtr, float *sizefloatptr, float *colorfloatptr)
{
    ImGui::TableNextRow();
