bool realVisible(ASTExtraPlayerController *localController, ASTExtraPlayerCharacter *m_player, FVector HeadPos)
{
    FHitResult hit{0};
    auto actorsToIgnore = TArray<AActor *>();
    return !SDK::UKismetSystemLibrary::LineTraceSingle(
        GetFullWorld(),
        localController->PlayerCameraManager->CameraCache.POV.Location,
        HeadPos,
        ETraceTypeQuery::TraceTypeQuery1,
        true,
        actorsToIgnore,
        EDrawDebugTrace::EDrawDebugTrace__None,
        0.0f,
        true,
        FLinearColor(),
        FLinearColor(),
        &hit);
}


void DrawCenteredLines(ImFont* pFont, float FontSize, const std::vector<std::string>& lines,
                       const std::vector<ImColor>& colors, float x, float y, float spacing = 5.0f)
{
    if (lines.empty()) return;
    if (lines.size() != colors.size()) return; // ✅ make sure sizes match

    auto* pImGuiDraw = ImGui::GetBackgroundDrawList();

    // Find the widest line
    float maxWidth = 0.0f;
    std::vector<ImVec2> sizes;
    sizes.reserve(lines.size());

    for (const auto& line : lines)
    {
        ImVec2 sz = pFont->CalcTextSizeA(FontSize, FLT_MAX, 0.0f, line.c_str());
        sizes.push_back(sz);
        if (sz.x > maxWidth)
            maxWidth = sz.x;
    }

    float curY = y;

    // Draw all lines centered with their own color
    for (size_t i = 0; i < lines.size(); i++)
    {
        float drawX = x + (maxWidth - sizes[i].x) / 2.0f;
        pImGuiDraw->AddText(pFont, FontSize, ImVec2(drawX, curY), colors[i], lines[i].c_str());
        curY += sizes[i].y + spacing;
    }
}
